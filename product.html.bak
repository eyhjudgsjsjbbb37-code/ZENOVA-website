<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="اكتشف منتجات ZENOVA الرقمية" />
    <title>منتجات ZENOVA</title>

    <link rel="stylesheet" href="style.css" />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="topbar">
      <a class="brand" href="index.html">
        <span class="logo-mark">Z</span>
        <span class="brand-name">
          ZENOVA
          <small>Ideas Become Products</small>
        </span>
      </a>

      <nav class="main-nav">
        <a href="index.html#home">الرئيسية</a>
        <a href="index.html#products">منتجاتنا</a>
        <a href="index.html#about">من نحن</a>
        <a href="index.html#reviews">التقييمات</a>
        <a href="index.html#contact">تواصل معنا</a>
      </nav>

      <a href="index.html#contact" class="header-btn">تواصل معنا ↗</a>
    </header>

    <main>
      <section class="section product-page">
        <div class="section-heading">
          <p class="eyebrow">ZENOVA DIGITAL STORE</p>
          <h1 id="product-title">اكتشف منتجاتنا</h1>
          <p id="product-description">
            أفكار تتحول إلى منتجات رقمية تقدم قيمة حقيقية.
          </p>
        </div>

        <div class="coming-card product-details">
          <div class="coming-icon" id="product-icon">Z</div>

          <span class="tag" id="product-status">قريبًا</span>

          <h2 id="product-name">مرحبًا بك في ZENOVA</h2>

          <p id="product-details">نعمل على تطوير منتجات رقمية مميزة.</p>

          <div class="coming-line"></div>

          <span class="coming-label">IDEAS BECOME PRODUCTS</span>
          <a href="index.html#products" class="product-back">
            العودة إلى المنتجات ←
          </a>
        </div>
      </section>
    </main>

    <footer class="footer">
      <p>© 2026 ZENOVA — Ideas Become Products</p>
    </footer>

    <script src="product.js"></script>
  </body>
</html>
